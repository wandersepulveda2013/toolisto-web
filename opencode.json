{
  "$schema": "https://opencode.ai/config.json",
  "username": "toolisto-dev",
  "default_agent": "toolisto-autonomous",
  "instructions": [
    "AGENTS.md",
    "workspace/AUTONOMOUS-CONTEXT.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git branch*": "allow",
      "git stash*": "allow",
      "git push*": "allow",
      "git merge*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git tag*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git remote -v*": "allow",
      "git rev-parse*": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "python *": "allow",
      "pip *": "allow",
      "ls*": "allow",
      "dir*": "allow",
      "cat *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "pwd*": "allow",
      "mkdir *": "allow",
      "copy *": "allow",
      "xcopy *": "allow",
      "move *": "allow",
      "ren *": "allow",
      "Get-Content *": "allow",
      "Set-Content *": "allow",
      "Get-ChildItem *": "allow",
      "New-Item *": "allow",
      "Test-Path *": "allow",
      "Select-String *": "allow",
      "Select-Object *": "allow",
      "Where-Object *": "allow",
      "Measure-Object *": "allow",
      "Start-Process *": "allow",
      "curl.exe -sI*": "allow",
      "curl.exe -s -I*": "allow",
      "curl.exe -sL http*": "allow",
      "curl.exe -s http*": "allow",
      "curl.exe -I http*": "allow",
      "gh *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "curl.exe *-X POST*": "deny",
      "curl.exe *-X PUT*": "deny",
      "curl.exe *-X PATCH*": "deny",
      "curl.exe *-X DELETE*": "deny",
      "curl.exe *--request POST*": "deny",
      "curl.exe *--request PUT*": "deny",
      "curl.exe *--request PATCH*": "deny",
      "curl.exe *--request DELETE*": "deny",
      "curl.exe * -d *": "deny",
      "curl.exe * --data *": "deny",
      "curl.exe * --data-raw *": "deny",
      "curl.exe * --data-binary *": "deny",
      "curl.exe * --json *": "deny",
      "curl.exe * -F *": "deny",
      "curl.exe * --form *": "deny",
      "curl.exe * -T *": "deny",
      "curl.exe * --upload-file *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git branch -D*": "deny",
      "git branch --delete*": "deny",
      "git checkout --*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -r -f*": "deny",
      "Remove-Item -Recurse*": "deny",
      "Remove-Item -Force*": "deny",
      "Remove-Item* -Recurse*": "deny",
      "Remove-Item* -Force*": "deny",
      "ri -Recurse*": "deny",
      "ri -Force*": "deny",
      "del /s*": "deny",
      "rd /s*": "deny",
      "rmdir /s*": "deny"
    },
    "task": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
